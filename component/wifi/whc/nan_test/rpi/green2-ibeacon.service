[Unit]
Description=Continuous Green2 iBeacon advertisement
Wants=bluetooth.service green2-hci-uart.service
After=bluetooth.service green2-hci-uart.service
PartOf=green2-hci-uart.service
StartLimitIntervalSec=0

[Service]
Type=simple
WorkingDirectory=/home/axk
ExecStart=/usr/bin/python3 /home/axk/ibeacon.py --adapter hci1 --calibration /home/axk/ibeacon-calibration.json --duration 0
Restart=on-failure
RestartSec=5
TimeoutStopSec=20
UMask=0077
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
