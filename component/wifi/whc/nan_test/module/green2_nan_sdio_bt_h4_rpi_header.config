# Green2 J11 directly mated to the Raspberry Pi 40-pin header.
# Pin 32: Pi GPIO12/UART5 TX -> Green2 PC2/UART0 RX.
# Pin 33: Pi GPIO13/UART5 RX <- Green2 PC4/UART0 TX.
# Confirm PC2/PC4 are not used by the board's active flash interface.
CONFIG_SRAM_KM4NS_IMG2_KB=96
CONFIG_WHC_DEV_MENU=y
CONFIG_WHC_DEV_FLASH_BOOT=y
CONFIG_WIFI_NAN_ENABLE=y
CONFIG_WHC_INTF_SPDIO=y
CONFIG_SDIO_PIN_GRP=1
CONFIG_ETHERNET=n
CONFIG_BT_MENU=y
CONFIG_BT_INIC_H4=y
CONFIG_BT_AMEBAGREEN2_FW=y
CONFIG_BT_INIC_H4_FLOW_CONTROL=n
CONFIG_BT_INIC_H4_TX_PIN=68
CONFIG_BT_INIC_H4_RX_PIN=66
