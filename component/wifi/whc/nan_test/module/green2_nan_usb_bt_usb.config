# Green2: NAN and Bluetooth HCI share the native USB composite device.
# EV711FL0 USB1: D+=PA4, D-=PA5. Disconnect the SDIO Group1 wiring.
# Linux binds WHC_USB to Wi-Fi and btusb to the Bluetooth interfaces.
CONFIG_SRAM_KM4NS_IMG2_KB=96
CONFIG_WHC_DEV_MENU=y
CONFIG_WHC_DEV_FLASH_BOOT=y
CONFIG_WIFI_NAN_ENABLE=y
CONFIG_WHC_INTF_USB=y
CONFIG_WHC_CMD_PATH=y
CONFIG_WHC_WIFI_API_PATH=y
# CONFIG_WHC_WPA_SUPPLICANT_OFFLOAD_FOR_KM4TZ is not set
# CONFIG_WHC_DEV_TCPIP_KEEPALIVE_FOR_KM4TZ is not set
# CONFIG_ETHERNET is not set
CONFIG_BT_MENU=y
CONFIG_BT_INIC_SHARE=y
CONFIG_BT_INIC_USB_SW_ENABLE=y
CONFIG_BT_AMEBAGREEN2_FW=y
