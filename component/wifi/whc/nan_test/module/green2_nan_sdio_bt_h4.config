# Green2: NAN over SDIO Group1, Bluetooth H4 over a separate UART0.
CONFIG_SRAM_KM4NS_IMG2_KB=96
CONFIG_WHC_DEV_MENU=y
CONFIG_WHC_DEV_FLASH_BOOT=y
CONFIG_WIFI_NAN_ENABLE=y
CONFIG_WHC_INTF_SPDIO=y
CONFIG_SDIO_PIN_GRP=1
# CONFIG_ETHERNET is not set
CONFIG_BT_MENU=y
CONFIG_BT_INIC_H4=y
CONFIG_BT_AMEBAGREEN2_FW=y
# EV711FL0 J21: TX=5, RX=8, CTS=3, RTS=4; GND=1/2.
# These pins avoid all six SDIO Group1 pins and need no NC resistor populated.
CONFIG_BT_INIC_H4_TX_PIN=25
CONFIG_BT_INIC_H4_RX_PIN=26
CONFIG_BT_INIC_H4_CTS_PIN=22
CONFIG_BT_INIC_H4_RTS_PIN=23
